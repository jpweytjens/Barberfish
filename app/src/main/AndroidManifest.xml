<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Karoo keeps its offline road data in shared storage. The grade map reads it to draw
         its band along the road; nothing is written. Asked for only when the rider turns
         the Karoo files "Offline maps" switch on. Lint's advice to use the media permissions
         does not apply: the road data is not media, and the Karoos run Android versions that
         still grant these. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".BarberfishApplication"
        android:icon="@drawable/ic_extension"
        android:label="@string/extension_name">

        <service
            android:name=".extension.BarberfishExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="${manifestUrl}" />

        <activity
            android:name=".screens.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Barberfish">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".extension.SparklineTapReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jpweytjens.barberfish.SPARKLINE_TAP" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
