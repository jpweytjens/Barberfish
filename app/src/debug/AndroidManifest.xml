<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!-- Debug-only: lets the layout sweep set the global DataFieldDesignConfig from adb.
             Exported so `adb shell am broadcast` (shell UID) can reach it. Never in release. -->
        <receiver
            android:name=".extension.DataFieldDesignReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.jpweytjens.barberfish.SET_DESIGN" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
